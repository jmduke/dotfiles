# =============================================================================
# Environment Variables
# =============================================================================

export HOMEBREW_PREFIX=/opt/homebrew
# Derive the dotfiles repo from the symlinked ~/.zshrc so moving the repo can't
# break the paths below. Falls back to the known location if readlink yields nothing.
DOTFILES_DIR="$(dirname "$(dirname "$(readlink ~/.zshrc)")")"
[ -d "$DOTFILES_DIR" ] || DOTFILES_DIR="$HOME/repositories/github.com/jmduke/dotfiles"
export DOTFILES_DIR
export HOMEBREW_NO_ENV_HINTS=1

# =============================================================================
# PATH Configuration
# =============================================================================

# Homebrew (must come early so brew-installed tools are available)
if [ -d "/opt/homebrew" ]; then
  export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
fi

# User binaries
export PATH="$HOME/bin:$PATH"

# Database clients
[ -d "/opt/homebrew/opt/mysql-client@8.4/bin" ] && export PATH="/opt/homebrew/opt/mysql-client@8.4/bin:$PATH"
[ -d "/opt/homebrew/Cellar/postgresql@17/17.5/bin" ] && export PATH="/opt/homebrew/Cellar/postgresql@17/17.5/bin:$PATH"

# Dotfiles scripts
[ -d "$HOME/dotfiles/scripts" ] && export PATH="$HOME/dotfiles/scripts:$PATH"

# Bun
[ -d "$HOME/.bun/bin" ] && export PATH="$HOME/.bun/bin:$PATH"

# Atuin (needs to be in PATH before init)
[ -f "$HOME/.atuin/bin/env" ] && . "$HOME/.atuin/bin/env"

# =============================================================================
# Tool Initialization
# =============================================================================

# Starship prompt
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"

# fzf (Ctrl-T = insert file path, Alt-C = cd into subdir). Loaded before atuin so
# atuin keeps Ctrl-R; fzf would otherwise rebind it.
command -v fzf >/dev/null 2>&1 && source <(fzf --zsh)

# Atuin shell history
command -v atuin >/dev/null 2>&1 && eval "$(atuin init zsh)"

# rbenv (Ruby version manager)
command -v rbenv >/dev/null 2>&1 && eval "$(rbenv init -)"

# mise (polyglot version manager)
[ -f "$HOME/.local/bin/mise" ] && eval "$(~/.local/bin/mise activate zsh)"

# zoxide (smart cd)
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

# =============================================================================
# Aliases
# =============================================================================

# eza as ls replacement
command -v eza >/dev/null 2>&1 && alias ls="eza -a --icons=always --hyperlink -1"

# bat as cat replacement
command -v bat >/dev/null 2>&1 && alias cat="bat"

# Zed editor
alias zed="open -a 'Zed'"

# Workflow scripts
alias w="work-on-branch.sh"
alias wg="work-on-worktree.sh"
alias s="stash.sh"
alias wip="commit-changes.sh"
alias wipc="commit-changes-cursor.sh"
alias n="$DOTFILES_DIR/scripts/new-branch.sh"

# =============================================================================
# Functions
# =============================================================================

# Update dotfiles from repo
update-dotfiles() {
  if [ -d "$DOTFILES_DIR" ]; then
    (cd "$DOTFILES_DIR" && git pull && ./install.sh)
  else
    echo "Error: dotfiles directory not found at $DOTFILES_DIR"
    return 1
  fi
}

# Re-create every dotfiles symlink (fast — skips the Homebrew section). Run after
# moving the dotfiles repo to repair ~/.zshrc, ~/.gitconfig, ~/bin/* etc.
relink-dotfiles() {
  "$DOTFILES_DIR/install.sh" --link-only
}

# Audit git repos under the current dir: path -> origin URL (or NO-REMOTE).
# Surfaces repos that aren't pushed anywhere or live in the wrong place.
# Optional arg = max search depth (default 4).
repo-audit() {
  fd -t d -H -E node_modules '^\.git$' -d "${1:-4}" | while read -r g; do
    local d="${g%/}"; d="${d%/.git}"   # fd appends a trailing slash to dirs
    printf '%-55s %s\n' "$d" "$(git -C "$d" remote get-url origin 2>/dev/null || echo NO-REMOTE)"
  done
}

# Jump to any ghq-managed repo (under ~/repositories) via fzf.
gr() {
  local dir
  dir="$(ghq list --full-path | fzf)" && cd "$dir"
}

# Make and cd into a dated scratch dir, keeping stray files out of ~.
#   scratch          -> ~/scratch/2026-06-13
#   scratch bug-352  -> ~/scratch/2026-06-13/bug-352
scratch() {
  local dir="$HOME/scratch/$(date +%Y-%m-%d)${1:+/$1}"
  mkdir -p "$dir" && cd "$dir"
}

# gh dash: cross-repo PR/issue dashboard.
alias dash="gh dash"

# =============================================================================
# Local Overrides
# =============================================================================

# Source local .zshrc files when changing directories
_source_local_zshrc() {
  local local_zshrc="./.zshrc"
  if [[ -f "$local_zshrc" && "${PWD}" != "$HOME" ]]; then
    echo "Sourcing local .zshrc..."
    source "$local_zshrc"
  fi
}

# Guard the hook: if the helper isn't defined (e.g. session restore or a
# non-interactive shell that didn't fully source this file), do nothing
# instead of erroring with "command not found".
chpwd() { (( $+functions[_source_local_zshrc] )) && _source_local_zshrc }
_source_local_zshrc

# Source machine-specific config if it exists
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"

# bun completions
[ -s "/Users/jmduke/.bun/_bun" ] && source "/Users/jmduke/.bun/_bun"

# For scraping.
ulimit -n 10240

export MISE_EXPERIMENTAL=1
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.local/share/mise/shims:$PATH"
alias vim="nvim"
alias pyt="$DOTFILES_DIR/scripts/pythia.sh"

# Production console (audited — keeps the audit gate via the BUTTONDOWN_PROD_CONSOLE marker)
alias pc="op run --no-masking --env-file=app/.env.production.tpl -- env BUTTONDOWN_PROD_CONSOLE=1 MISE_EXPERIMENTAL=true mise run //app:console"

# Production CLI (not audited — no marker)
pb() { op run --no-masking --env-file=app/.env.production.tpl -- env MISE_EXPERIMENTAL=true mise run //app:cli "$@" }
